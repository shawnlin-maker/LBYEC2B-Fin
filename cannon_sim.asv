%% Layer 0 + Layer 1: figure/axes + bare animation loop

%% plotting window/canvas
fig = figure;
ax = axes('Parent', fig);
axis(ax, [0 200 0 100]);
hold(ax, 'on');

%% creates ball
ballPlot = plot(ax, 0, 0, 'o', 'MarkerSize', 14, 'MarkerFaceColor', "r");

%% physics setup
v0 = 40;
angle = 45;
g = 9.81;
x = 0;
y = 0;

vx = v0 .* cosd(angle);
vy = v0 .* sind(angle);
dt = 0.5;


%% animation
while y >= 0
    vy = vy - g*dt;
    x = x
    y = y

    set(ballPlot, 'XData', x, 'YData', y)

    plot(set)